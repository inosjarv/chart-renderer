{
  "name": "chart-renderer",
  "version": "1.0.0",
  "description": "Server-side eCharts renderer with Express and TypeScript",
  "main": "dist/chart.js",
  "types": "dist/chart.d.ts",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/chart.d.ts",
      "require": "./dist/chart.js",
      "import": "./dist/chart.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "express": "^4.19.2",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
